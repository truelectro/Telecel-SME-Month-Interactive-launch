# ========================================================
# TELECEL SME MONTH LAUNCH REACTOR - CONFIGURATION
# ========================================================

# --- SECURITY & AUTHENTICATION ---
# Master password to unlock stage controls
VITE_LAUNCH_PASSWORD=your_secret_password_here

# --- SUPABASE VIDEO STORAGE CONFIGURATION ---
# Option 1: Supabase Project & Bucket Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_BUCKET=your_bucket_name
VITE_SUPABASE_VIDEO_1_PATH=video1.mp4
VITE_SUPABASE_VIDEO_2_PATH=video2.mp4

# Option 2: Direct Video Public URLs (Supabase Public Bucket or CDN)
VITE_VIDEO_1_URL=https://your-project.supabase.co/storage/v1/object/public/your_bucket/video1.mp4
VITE_VIDEO_2_URL=https://your-project.supabase.co/storage/v1/object/public/your_bucket/video2.mp4

# Titles for the 2 Videos
VITE_VIDEO_1_TITLE=TELECEL SME MONTH • LAUNCH VIDEO
VITE_VIDEO_2_TITLE=TELECEL SME SOLUTIONS • SPOTLIGHT

# --- SERVER & TUNNEL CONFIGURATION ---
PORT=3001
# RENDER_EXTERNAL_URL=
# DISABLE_TUNNEL=false
